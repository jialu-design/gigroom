# GigRoom Supabase 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# 绝对不要提交 .env.local 或包含真实密钥的文件

# Supabase 项目 URL（公开，客户端可用）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Key（公开，客户端可用，受 RLS 保护）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（⚠️ 仅服务端使用，绝对禁止出现在 NEXT_PUBLIC_* 或 client component）
SUPABASE_SERVICE_ROLE_KEY=

# 站点 URL（用于 OAuth 回调等）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
